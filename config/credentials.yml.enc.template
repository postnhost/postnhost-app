# Copy this file's keys into your encrypted credentials:
# EDITOR="vim" bin/rails credentials:edit
#
# Keep this file unencrypted and free of real secrets.

postnhost:
  # OpenAI
  openai_access_token: your_openai_key

  # S3-compatible uploads (CarrierWave)
  aws_access_key_id: your_access_key_id
  aws_secret_access_key: your_secret_access_key
  aws_bucket_name: your_s3_bucket_name
  aws_region: auto
  aws_endpoint_url_s3: https://fly.storage.tigris.dev

  # Litestream
  litestream_bucket: your_backup_bucket_name
  litestream_endpoint: fly.storage.tigris.dev

  # Mission Control Jobs basic auth
  mission_control:
    http_basic_auth_user:
    http_basic_auth_password:
